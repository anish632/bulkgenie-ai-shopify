generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id               String   @id @default(cuid())
  shopDomain       String   @unique
  aiProvider       String   @default("byok_anthropic") // "byok_openai" | "byok_anthropic"
  byokApiKey       String? // encrypted, nullable
  brandVoice       String? // brand voice instructions text
  sampleProductIds String? // JSON array of product IDs used for voice training
  tier             String   @default("free") // "free" | "starter" | "growth" | "scale"
  monthlyUsage     Int      @default(0) // products processed this billing cycle
  usageResetDate   DateTime @default(now())
  targetLanguage   String   @default("en") // ISO code
  descriptionLength String  @default("medium") // "short" | "medium" | "long"
  defaultFields    String   @default("[\"description\",\"seoTitle\",\"seoDescription\",\"altText\"]") // JSON array
  // Weekly scan settings
  weeklyScansEnabled  Boolean  @default(false)
  scanEmailRecipient  String?
  scanDayOfWeek       Int      @default(1) // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  autoApplyLowRisk    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ScanReport {
  id              String      @id @default(cuid())
  shopDomain      String
  status          String      @default("pending") // pending | running | completed | failed
  productsScanned Int         @default(0)
  issuesFound     Int         @default(0)
  fixesGenerated  Int         @default(0)
  approvedCount   Int         @default(0)
  rejectedCount   Int         @default(0)
  publishedCount  Int         @default(0)
  errorMessage    String?
  createdAt       DateTime    @default(now())
  completedAt     DateTime?
  issues          ScanIssue[]

  @@index([shopDomain, createdAt])
}

model ScanIssue {
  id               String     @id @default(cuid())
  scanReportId     String
  shopifyProductId String
  productTitle     String
  imageId          String? // only for altText issues
  issueType        String
  fieldName        String
  currentValue     String?
  severity         String     @default("medium") // low | medium | high
  status           String     @default("pending") // pending | fix_ready | approved | rejected | published | skipped
  proposedValue    String?
  editedValue      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  scanReport       ScanReport @relation(fields: [scanReportId], references: [id], onDelete: Cascade)

  @@index([scanReportId])
  @@index([shopifyProductId])
}

model Job {
  id             String    @id @default(cuid())
  shopDomain     String
  status         String    @default("pending") // "pending" | "processing" | "completed" | "failed" | "paused"
  totalProducts  Int       @default(0)
  processedCount Int       @default(0)
  failedCount    Int       @default(0)
  generateFields String // JSON: ["description", "seoTitle", "seoDescription", "altText"]
  aiProvider     String // snapshot of provider used for this job
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  items JobItem[]
}

model JobItem {
  id               String  @id @default(cuid())
  jobId            String
  shopifyProductId String // Shopify GID e.g. "gid://shopify/Product/123"
  shopifyVariantId String?
  productTitle     String
  status           String  @default("pending") // "pending" | "processing" | "generated" | "approved" | "published" | "failed" | "skipped"

  // Original content (backup for undo)
  originalDescription String?
  originalSeoTitle    String?
  originalSeoDesc     String?
  originalAltTexts    String? // JSON: { imageId: altText }

  // AI-generated content (staged, not yet published)
  generatedDescription String?
  generatedSeoTitle    String?
  generatedSeoDesc     String?
  generatedAltTexts    String? // JSON: { imageId: altText }

  // Merchant edits (if they modify the AI output before publishing)
  editedDescription String?
  editedSeoTitle    String?
  editedSeoDesc     String?
  editedAltTexts    String?

  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([shopifyProductId])
}
